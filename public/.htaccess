# Configuration Apache pour l'hébergement OVH (copiée telle quelle dans le build).

# Forcer le HTTPS.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Refuser l'accès aux robots connus (moteurs de recherche, robots d'IA, outils SEO).
  RewriteCond %{HTTP_USER_AGENT} (bot|crawl|spider|slurp|scrapy|python-requests|curl|wget|GPTBot|ChatGPT-User|ClaudeBot|Claude-Web|anthropic-ai|CCBot|Bytespider|PerplexityBot|Amazonbot|Applebot|meta-externalagent|FacebookExternalHit|AhrefsBot|SemrushBot|MJ12bot|DotBot|PetalBot|YandexBot|Baiduspider) [NC]
  RewriteRule ^ - [F,L]
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  # Demander aux moteurs de ne pas indexer ni suivre les liens.
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
  # Fichiers qui doivent toujours être revérifiés pour que les mises à jour arrivent.
  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Fichiers du build dont le nom contient une empreinte : mis en cache un an.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/manifest+json image/svg+xml
</IfModule>
